# Architectural rules, made executable; enforced by tests/test_lint.py.  Run: lint-imports

[importlinter]
root_packages =
    src
    scripts
# Required for the blender contract, which forbids the project's own third-party dependencies.
include_external_packages = True


[importlinter:contract:blender-is-not-in-the-venv]
name = Blender scripts import nothing from this project or its venv
type = forbidden
source_modules =
    scripts.blender
forbidden_modules =
    src
    requests
    geopandas
    shapely
    numpy
    pyproj
    yaml
# scripts/blender/*.py run inside Blender's own interpreter, which has bpy and mathutils and none
# of this: the first thing to fail would be a render, minutes in, inside a subprocess. The sibling
# blender_*.py modules are imported by bare name, so they read as external and are not listed.


[importlinter:contract:sources-do-not-know-how-they-are-drawn]
name = Reading OSM does not import the render stage
type = forbidden
source_modules =
    src.sources
forbidden_modules =
    src.render


[importlinter:contract:standards-is-stdlib-only]
name = src.standards imports only the standard library, so Blender can load it by path
type = forbidden
source_modules =
    src.standards
forbidden_modules =
    src.osm_world
    src.osm_osc
    src.sources
    src.render
    requests
    geopandas
    shapely
    numpy
    pandas
    pyproj
    yaml
